# ════════════════════════════════════════════════════════════════════
#  ado-Bot — variables de entorno
#
#  Copia este archivo a `.env` (que NO se sube, está en .gitignore) y
#  rellena lo que uses:
#
#      cp .env.example .env
#
#  Se lee en `env.js`, que arranca antes que todo lo demás. Lo que pongas
#  en la orden manda sobre el archivo:
#
#      ANTIBAN=off npm start
# ════════════════════════════════════════════════════════════════════

# ── Dueños del bot ─────────────────────────────────────────────────
# Lista separada por comas con formato Nombre:número (solo dígitos).
# Si se deja vacío, el bot usa la lista que está en `config.js`.
# Poniéndola aquí, los números dejan de estar publicados en GitHub.
# OWNERS="Sergio Dev:5358090650,Jeferson:573005255807,Roxi:5215574370309"

# El dueño principal (el que sale en `.info` y en el botón de llamada).
# OWNER_NAME="Sergio Dev 💫"
# OWNER_NUMBER=5358090650

# ── Claves de API (ninguna es obligatoria) ─────────────────────────
# Clave del proveedor "vihangayt". Ningún archivo del bot la usa hoy; se
# deja documentada porque estaba escrita a mano en `config.js`.
# VIHANGAYT_KEY=
# Música con IA (`.iam`). Sin clave, ese comando lo dice y el resto sigue.
# SUNO_API_KEY=
# Descargas de YouTube por el método alternativo.
# NATSU_API_KEY=

# ── Conexión ───────────────────────────────────────────────────────
# Número con el que se vincula el bot (si no se pasa por consola).
# WHATSAPP_NUMBER=
# Qué cliente de WhatsApp se usa. Por defecto el fork @itsliaaa/baileys;
# el oficial queda como respaldo.
# BAILEYS_PACKAGE=@itsliaaa/baileys

# ── Anti-ban / ritmo humano ────────────────────────────────────────
# ANTIBAN=off        apaga el anti-ban entero (no recomendado)
# RITMO=off          apaga el ritmo circadiano y las esperas humanas
# WARMUP_PERFIL=auto auto · nuevo · veterano  (cupo diario de mensajes)
# FACTOR_GRUPO=1.5   multiplicador del cupo en grupos
# RITMO_NIVEL=       fuerza un nivel de actividad en vez de detectarlo

# ── Presentación ───────────────────────────────────────────────────
# PRESENCIA=available   available · unavailable · composing · recording
# BOTONES=1             fuerza los botones (por defecto se deciden solos)
# BOTONES_FORMATO=      native · template · auto
# BOTONES_VIEWONCE=1    envía los interactivos dentro de viewOnceMessage
# PANEL_URL=https://riokuroxi-svg.github.io/
#                      HTTPS del panel web que abre `.panel` (open_webview)

# ── Rutas de las herramientas externas ─────────────────────────────
# Solo si ffmpeg/ffprobe no están en el PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# FLVMETA_PATH=
# FLVTOOL2_PATH=

# ── Depuración ─────────────────────────────────────────────────────
# GACHA_DEBUG=1      trazas del gacha
# LEVI_VIGILADO=1    lo pone el vigía (scripts/vigia.mjs); no se toca a mano
# GITHUB_TOKEN=      solo para los scripts que consultan GitHub
# GITHUB_OWNER=      idem
# GITHUB_REPO=       idem
